<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Hush AI</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --black:#040405;
  --deep:#08080b;
  --card:#0e0e12;
  --card2:#131318;
  --gold:#C9A84C;
  --gold2:#e8c96a;
  --gold3:#a8862e;
  --gold4:#f5d98a;
  --gdim:rgba(201,168,76,0.12);
  --gline:rgba(201,168,76,0.22);
  --gglow:rgba(201,168,76,0.06);
  --white:#f5f0e8;
  --muted:rgba(245,240,232,0.38);
  --muted2:rgba(245,240,232,0.6);
  --green:#00e89a;
  --red:#ff4757;
  --cyan:#00d4ff;
}
html,body{height:100%;background:#000;overflow:hidden;font-family:'Outfit',sans-serif;color:var(--white)}

/* ── SHELL ── */
.shell{
  width:100%;height:100vh;
  display:flex;align-items:center;justify-content:center;
  background:radial-gradient(ellipse at 50% 60%,#1a1205 0%,#040405 65%);
  position:relative;
}
.shell::after{
  content:'';position:absolute;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
  pointer-events:none;opacity:.5;
}

.phone{
  width:min(390px,100vw);
  height:min(844px,100vh);
  background:var(--black);
  border-radius:min(44px,5vw);
  overflow:hidden;position:relative;
  box-shadow:0 0 0 1px rgba(201,168,76,.18),0 0 80px rgba(201,168,76,.07),0 60px 160px rgba(0,0,0,.9);
}

/* ── CANVAS for particles ── */
#particleCanvas{position:absolute;inset:0;z-index:0;pointer-events:none}

/* ── SCREENS ── */
.screens{position:absolute;inset:0;z-index:1}
.screen{
  position:absolute;inset:0;
  opacity:0;pointer-events:none;
  transition:opacity .55s cubic-bezier(.4,0,.2,1);
  overflow-y:auto;overflow-x:hidden;
  scrollbar-width:none;
}
.screen::-webkit-scrollbar{display:none}
.screen.active{opacity:1;pointer-events:all}

/* ════════════════════════════════════════
   SCREEN 0 — CINEMATIC INTRO
════════════════════════════════════════ */
#s0{
  background:var(--black);
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  position:relative;overflow:hidden;
}
.intro-ring{
  position:absolute;
  border-radius:50%;border:1px solid var(--gline);
  animation:ringPulse 3s ease-in-out infinite;
  opacity:0;
}
.intro-ring:nth-child(1){width:200px;height:200px;animation-delay:0s}
.intro-ring:nth-child(2){width:320px;height:320px;animation-delay:.4s}
.intro-ring:nth-child(3){width:440px;height:440px;animation-delay:.8s}
.intro-ring:nth-child(4){width:560px;height:560px;animation-delay:1.2s}
@keyframes ringPulse{
  0%{opacity:0;transform:scale(.85)}
  40%{opacity:.4}
  100%{opacity:0;transform:scale(1.05)}
}

.intro-h{
  font-family:'Bebas Neue',sans-serif;
  font-size:130px;
  line-height:1;
  background:linear-gradient(160deg,var(--gold3) 0%,var(--gold4) 35%,var(--gold) 55%,var(--gold3) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  filter:drop-shadow(0 0 32px rgba(201,168,76,.5));
  animation:introH 1.2s cubic-bezier(.16,1,.3,1) forwards;
  opacity:0;position:relative;z-index:2;
}
@keyframes introH{
  0%{opacity:0;transform:scale(.6) translateY(20px)}
  60%{opacity:1;transform:scale(1.05) translateY(-4px)}
  100%{opacity:1;transform:scale(1) translateY(0)}
}

.intro-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:38px;letter-spacing:.25em;
  background:linear-gradient(90deg,var(--gold3),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  animation:fadeUp .8s 1s ease both;
  position:relative;z-index:2;
}

.intro-tag{
  font-family:'Cormorant Garamond',serif;
  font-style:italic;font-size:18px;
  color:var(--muted);letter-spacing:.04em;
  margin-top:10px;
  animation:fadeUp .8s 1.3s ease both;
  position:relative;z-index:2;text-align:center;
  padding:0 32px;
}

.intro-line{
  width:80px;height:1px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
  margin:28px 0;
  animation:fadeUp .8s 1.6s ease both;
  position:relative;z-index:2;
}

.intro-btn{
  background:linear-gradient(135deg,var(--gold3) 0%,var(--gold) 50%,var(--gold2) 100%);
  border:none;border-radius:3px;
  font-family:'Bebas Neue',sans-serif;
  font-size:17px;letter-spacing:.25em;
  color:var(--black);
  padding:18px 48px;cursor:pointer;
  animation:fadeUp .8s 1.9s ease both;
  position:relative;z-index:2;
  box-shadow:0 8px 40px rgba(201,168,76,.3);
  transition:all .2s;
}
.intro-btn:active{transform:scale(.97)}

.intro-powered{
  position:absolute;bottom:28px;
  font-size:9px;letter-spacing:.22em;
  color:rgba(245,240,232,.15);text-transform:uppercase;
  animation:fadeUp .8s 2.2s ease both;z-index:2;
}

/* ════════════════════════════════════════
   SHARED COMPONENTS
════════════════════════════════════════ */
@keyframes fadeUp{
  from{opacity:0;transform:translateY(18px)}
  to{opacity:1;transform:translateY(0)}
}

.top-bar{
  display:flex;align-items:center;justify-content:space-between;
  padding:52px 22px 18px;
  background:var(--black);
  border-bottom:1px solid var(--gline);
  position:sticky;top:0;z-index:10;
}
.top-logo{
  font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.15em;
  background:linear-gradient(135deg,var(--gold3),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.top-right{display:flex;align-items:center;gap:10px}
.notif-wrap{
  width:36px;height:36px;border-radius:50%;
  border:1px solid var(--gline);
  display:flex;align-items:center;justify-content:center;
  font-size:16px;position:relative;cursor:pointer;
}
.notif-wrap::after{
  content:'3';position:absolute;top:-4px;right:-4px;
  width:16px;height:16px;background:var(--gold);
  border-radius:50%;font-size:9px;font-weight:700;
  color:var(--black);display:flex;align-items:center;justify-content:center;
  line-height:16px;text-align:center;
}

.scroll-area{padding:24px 20px 110px}

.sec-label{
  font-size:10px;letter-spacing:.22em;color:var(--gold);
  text-transform:uppercase;margin-bottom:14px;
  display:flex;align-items:center;gap:8px;
}
.live-dot{
  width:6px;height:6px;border-radius:50%;background:var(--green);
  animation:blink 1.5s ease-in-out infinite;flex-shrink:0;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}

/* ── NAV ── */
.nav-bar{
  position:absolute;bottom:0;left:0;right:0;
  background:var(--black);
  border-top:1px solid var(--gline);
  display:flex;padding:10px 0 26px;z-index:100;
}
.nav-item{
  flex:1;display:flex;flex-direction:column;
  align-items:center;gap:3px;cursor:pointer;padding:4px 0;
}
.nav-ico{font-size:21px;opacity:.32;transition:opacity .2s}
.nav-lbl{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);transition:color .2s}
.nav-pip{width:4px;height:4px;border-radius:50%;background:var(--gold);opacity:0;transition:opacity .2s;margin:0 auto}
.nav-item.active .nav-ico{opacity:1}
.nav-item.active .nav-lbl{color:var(--gold)}
.nav-item.active .nav-pip{opacity:1}

/* ── CARDS ── */
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}
.stat-card{
  background:var(--card);border:1px solid var(--gline);
  border-radius:8px;padding:18px 14px;position:relative;overflow:hidden;
}
.stat-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--gold3),var(--gold2));
}
.stat-lbl{font-size:10px;letter-spacing:.12em;color:var(--muted);text-transform:uppercase;margin-bottom:6px}
.stat-val{
  font-family:'Bebas Neue',sans-serif;font-size:34px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;
}
.stat-sub{font-size:11px;color:var(--green);margin-top:3px}
.stat-sub.gold{color:var(--gold)}

/* ── FEED CARDS ── */
.feed-card{
  background:var(--card);border:1px solid rgba(201,168,76,.1);
  border-radius:8px;padding:14px;margin-bottom:10px;
  display:flex;gap:12px;align-items:flex-start;cursor:pointer;
  transition:border-color .2s;
}
.feed-card:active{border-color:var(--gline)}
.feed-av{
  width:40px;height:40px;border-radius:50%;
  background:linear-gradient(135deg,#1a1408,#2a2010);
  border:1px solid var(--gline);
  display:flex;align-items:center;justify-content:center;
  font-family:'Bebas Neue',sans-serif;font-size:15px;color:var(--gold2);flex-shrink:0;
}
.feed-body{flex:1;min-width:0}
.feed-name{font-size:14px;font-weight:500;color:var(--white);margin-bottom:2px}
.feed-msg{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.feed-time{font-size:10px;color:var(--muted);flex-shrink:0}
.badge{
  display:inline-block;font-size:9px;letter-spacing:.1em;
  padding:2px 7px;border-radius:2px;text-transform:uppercase;margin-top:4px;
}
.badge.ai{background:var(--gdim);border:1px solid var(--gline);color:var(--gold)}
.badge.booked{background:rgba(0,232,154,.1);border:1px solid rgba(0,232,154,.28);color:var(--green)}
.badge.warm{background:rgba(255,71,87,.08);border:1px solid rgba(255,71,87,.25);color:var(--red)}

/* ════════════════════════════════════════
   SCREEN 1 — DASHBOARD
════════════════════════════════════════ */
#s1{background:var(--deep)}

.welcome-bar{
  background:linear-gradient(135deg,rgba(201,168,76,.1) 0%,transparent 60%);
  border:1px solid var(--gline);border-radius:8px;
  padding:20px;margin-bottom:20px;position:relative;overflow:hidden;
}
.welcome-bar::after{
  content:'NIDDY';
  position:absolute;right:-8px;top:50%;transform:translateY(-50%);
  font-family:'Bebas Neue',sans-serif;font-size:72px;
  color:rgba(201,168,76,.04);pointer-events:none;letter-spacing:.1em;
}
.welcome-eyebrow{font-size:10px;letter-spacing:.22em;color:var(--gold);text-transform:uppercase;margin-bottom:4px}
.welcome-name{
  font-family:'Cormorant Garamond',serif;font-size:30px;font-weight:300;
  color:var(--white);
}
.welcome-sub{font-size:12px;color:var(--muted);margin-top:2px}

/* Revenue counter banner */
.rev-banner{
  background:linear-gradient(135deg,rgba(201,168,76,.1),rgba(201,168,76,.04));
  border:1px solid var(--gline);border-radius:8px;
  padding:22px 20px;margin-bottom:20px;text-align:center;
  cursor:pointer;
}
.rev-eyebrow{font-size:9px;letter-spacing:.25em;color:var(--gold);text-transform:uppercase;margin-bottom:6px}
.rev-amount{
  font-family:'Bebas Neue',sans-serif;font-size:52px;line-height:1;
  background:linear-gradient(135deg,var(--gold3),var(--gold4));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  filter:drop-shadow(0 0 20px rgba(201,168,76,.35));
}
.rev-sub{font-size:11px;color:var(--muted);margin-top:6px}

/* ════════════════════════════════════════
   SCREEN 2 — MESSAGES / AI SMS
════════════════════════════════════════ */
#s2{background:var(--deep);display:flex;flex-direction:column}
.chat-hdr{
  padding:52px 20px 16px;background:var(--black);
  border-bottom:1px solid var(--gline);
  display:flex;align-items:center;gap:12px;
}
.chat-back{
  width:32px;height:32px;display:flex;align-items:center;justify-content:center;
  cursor:pointer;color:var(--gold);font-size:24px;line-height:1;
}
.chat-ai-name{
  font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:.1em;
  background:linear-gradient(135deg,var(--gold3),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.chat-status{font-size:11px;color:var(--green);display:flex;align-items:center;gap:5px}

.chat-scroll{
  flex:1;overflow-y:auto;padding:20px 16px;
  display:flex;flex-direction:column;gap:12px;
  scrollbar-width:none;padding-bottom:80px;
}
.chat-scroll::-webkit-scrollbar{display:none}

.msg{max-width:80%;padding:12px 16px;font-size:14px;line-height:1.55;position:relative}
.msg.in{
  background:var(--card2);border:1px solid rgba(201,168,76,.1);
  border-radius:4px 16px 16px 16px;align-self:flex-start;color:var(--white);
}
.msg.out{
  background:linear-gradient(135deg,rgba(201,168,76,.16),rgba(201,168,76,.08));
  border:1px solid var(--gline);
  border-radius:16px 4px 16px 16px;align-self:flex-end;color:var(--white);
}
.msg-lbl{font-size:9px;letter-spacing:.15em;color:var(--gold);text-transform:uppercase;margin-bottom:4px}
.msg-lbl.right{text-align:right}
.msg-time{font-size:10px;color:var(--muted);margin-top:4px;text-align:right}

.ai-pill{
  align-self:center;
  background:var(--gdim);border:1px solid var(--gline);
  border-radius:20px;padding:5px 14px;
  font-size:10px;color:var(--gold);letter-spacing:.1em;
}
.ai-pill.green{
  background:rgba(0,232,154,.08);border-color:rgba(0,232,154,.28);color:var(--green);
}

.typing-row{display:flex;justify-content:flex-end;padding:2px 0}
.typing-bubble{
  background:var(--card2);border:1px solid var(--gline);
  border-radius:16px 4px 16px 16px;
  padding:12px 18px;display:flex;gap:4px;align-items:center;
}
.t-dot{
  width:5px;height:5px;border-radius:50%;background:var(--gold);
  animation:tdot 1.4s infinite;
}
.t-dot:nth-child(2){animation-delay:.2s}
.t-dot:nth-child(3){animation-delay:.4s}
@keyframes tdot{0%,60%,100%{opacity:.2;transform:scale(.8)}30%{opacity:1;transform:scale(1)}}

.chat-input-bar{
  padding:12px 16px 32px;background:var(--black);
  border-top:1px solid var(--gline);
  display:flex;gap:10px;align-items:center;
}
.chat-inp{
  flex:1;background:var(--card);border:1px solid var(--gline);
  border-radius:24px;padding:12px 18px;font-size:14px;
  color:var(--white);outline:none;font-family:'Outfit',sans-serif;
}
.chat-inp::placeholder{color:var(--muted)}
.send-btn{
  width:42px;height:42px;border-radius:50%;
  background:linear-gradient(135deg,var(--gold3),var(--gold));
  border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;
  color:var(--black);font-size:16px;flex-shrink:0;
}

/* ════════════════════════════════════════
   SCREEN 3 — LEADS
════════════════════════════════════════ */
#s3{background:var(--deep)}

.lead-card{
  background:var(--card);border:1px solid rgba(201,168,76,.1);
  border-radius:8px;padding:16px;margin-bottom:10px;cursor:pointer;
  transition:border-color .2s;
}
.lead-card.hot{border-color:rgba(201,168,76,.28)}
.lead-card:active{border-color:var(--gold)}
.lead-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px}
.lead-name{font-size:15px;font-weight:500;color:var(--white)}
.status-pill{
  font-size:9px;letter-spacing:.1em;text-transform:uppercase;
  padding:3px 9px;border-radius:2px;font-weight:600;flex-shrink:0;
}
.status-pill.booked{background:rgba(0,232,154,.12);color:var(--green);border:1px solid rgba(0,232,154,.3)}
.status-pill.warm{background:var(--gdim);color:var(--gold);border:1px solid var(--gline)}
.status-pill.new{background:rgba(0,212,255,.08);color:var(--cyan);border:1px solid rgba(0,212,255,.25)}
.lead-event{font-size:12px;color:var(--muted);margin-bottom:7px}
.lead-meta{display:flex;gap:14px}
.lead-meta span{font-size:11px;color:var(--muted2)}

.zero-missed{
  text-align:center;padding:20px;
  border:1px dashed var(--gline);border-radius:8px;margin-top:4px;
}
.zero-missed-val{
  font-family:'Bebas Neue',sans-serif;font-size:42px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.zero-missed-lbl{font-size:10px;letter-spacing:.2em;color:var(--gold);text-transform:uppercase;margin-top:2px}

/* ════════════════════════════════════════
   SCREEN 4 — POSH vs HUSH COMPARISON
════════════════════════════════════════ */
#s4{background:var(--deep)}

.compare-hero{
  background:var(--black);padding:52px 20px 24px;
  border-bottom:1px solid var(--gline);
  text-align:center;
}
.compare-eyebrow{font-size:10px;letter-spacing:.25em;color:var(--gold);text-transform:uppercase;margin-bottom:10px}
.compare-title{
  font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:.08em;
  color:var(--white);line-height:1.1;
}
.compare-sub{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:15px;color:var(--muted);margin-top:8px;
}

.vs-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--gline);margin:20px 20px 0}
.vs-col{background:var(--black);padding:18px 14px}
.vs-header{
  font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.08em;
  margin-bottom:14px;text-align:center;padding-bottom:12px;
  border-bottom:1px solid;
}
.vs-header.posh{color:rgba(245,240,232,.35);border-color:rgba(245,240,232,.1)}
.vs-header.hush{
  background:linear-gradient(135deg,var(--gold3),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  border-color:var(--gline);
}

.vs-row{
  display:flex;flex-direction:column;gap:10px;
}
.vs-item{padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)}
.vs-item:last-child{border-bottom:none}
.vs-item-label{font-size:9px;letter-spacing:.15em;text-transform:uppercase;margin-bottom:4px}
.vs-item-label.posh{color:rgba(245,240,232,.25)}
.vs-item-label.hush{color:var(--gold)}
.vs-item-val{font-size:13px;line-height:1.4}
.vs-item-val.posh{color:rgba(245,240,232,.4)}
.vs-item-val.hush{color:var(--white)}

.vs-icon{font-size:14px;margin-right:4px}

.killer-line{
  margin:20px;
  background:linear-gradient(135deg,rgba(201,168,76,.12),rgba(201,168,76,.05));
  border:1px solid var(--gline);border-left:3px solid var(--gold);
  border-radius:4px;padding:18px 20px;
}
.killer-line p{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:18px;line-height:1.55;color:var(--white);
}
.killer-line strong{color:var(--gold);font-style:normal}

/* ════════════════════════════════════════
   SCREEN 5 — NETWORK / MOGUL
════════════════════════════════════════ */
#s5{background:var(--deep)}

.mogul-hero{
  background:linear-gradient(160deg,rgba(201,168,76,.12) 0%,transparent 60%);
  border:1px solid var(--gline);border-radius:8px;
  padding:24px 20px;margin-bottom:20px;position:relative;overflow:hidden;
}
.mogul-hero::after{
  content:'NIDDY';
  position:absolute;right:-12px;top:50%;transform:translateY(-50%);
  font-family:'Bebas Neue',sans-serif;font-size:88px;
  color:rgba(201,168,76,.04);pointer-events:none;letter-spacing:.1em;
}
.mogul-tier{font-size:9px;letter-spacing:.25em;color:var(--gold);text-transform:uppercase;margin-bottom:6px}
.mogul-name{
  font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:300;
  color:var(--white);margin-bottom:3px;
}
.mogul-role{font-size:12px;color:var(--muted)}
.mogul-stats{
