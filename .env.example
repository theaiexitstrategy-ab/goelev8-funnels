#
# Non-secret placeholder values for every env var this repo reads at
# runtime or in scripts. Copy this file to .env.local for local dev and
# fill in real values. Vercel manages production values in the project
# dashboard — never commit real keys to git.

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# ── Stripe (single account, mode determined by key prefix) ────────
# sk_test_ = test mode, sk_live_ = live mode. Whatever key you set here
# determines what mode ALL Stripe operations (checkout, webhook,
# scripts/*, price lookups) run in.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional dedicated webhook secret used by /api/onboard/webhook (Leslie's
# legacy signup flow). If unset, falls back to STRIPE_WEBHOOK_SECRET.
STRIPE_ONBOARD_WEBHOOK_SECRET=whsec_...

# Founding Client Payment Link fallback used by the DEMO SMS sequence.
# Optional — /api/demo-webhook falls back to the hardcoded link in
# lib/demo-sequence.ts if unset.
STRIPE_FOUNDING_PAYMENT_LINK=https://buy.stripe.com/...

# ── Stripe Price IDs — McClain intake tiers ───────────────────────
# Populated by running: STRIPE_SECRET_KEY=sk_... npx tsx scripts/create-mcclain-stripe-products.ts
# The script prints these in paste-friendly form at the end. Test IDs
# and live IDs are different — re-run the script with a live key when
# you're ready to flip the /mcclain/demo flow to production.
STRIPE_MCCLAIN_BASE_MONTHLY_PRICE_ID=price_...
STRIPE_MCCLAIN_BASE_SETUP_PRICE_ID=price_...
STRIPE_MCCLAIN_GROWTH_MONTHLY_PRICE_ID=price_...
STRIPE_MCCLAIN_GROWTH_SETUP_PRICE_ID=price_...
STRIPE_MCCLAIN_FULLSCALE_MONTHLY_PRICE_ID=price_...
STRIPE_MCCLAIN_FULLSCALE_SETUP_PRICE_ID=price_...

# ── Twilio ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+18883020649

# ── Admin (recipient for Aaron-notify SMS/email) ──────────────────
ADMIN_PHONE=+13145551234

# ── Anthropic (onboarding chat agent) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Resend (transactional email) ──────────────────────────────────
RESEND_API_KEY=re_...

# ── Internal-only API key (guards /api/provisioning/*) ────────────
INTERNAL_API_KEY=<generate a long random string>

# ── App URL (used in success/cancel redirect URLs) ────────────────
NEXT_PUBLIC_APP_URL=https://www.goelev8.ai
